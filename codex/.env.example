# Miniflux 配置
MINIFLUX_URL=http://localhost/v1
MINIFLUX_TOKEN=your_miniflux_token_here
MINIFLUX_WEBHOOK_SECRET=

# Discord 配置
DISCORD_TIMEOUT_S=10.0
DISCORD_MAX_RETRIES=3

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./data/relay.db

# 翻译配置（硅基流动）
TRANSLATE_PROVIDER=siliconflow
SILICONFLOW_API_KEY=your_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=Qwen/Qwen3-VL-32B-Instruct

# 应用配置
APP_ENV=development
LOG_LEVEL=INFO
